# Example settings for the backend. Copy this file to .env and fill in real values.
# The real .env file is ignored by Git, so secrets never reach GitHub.

# Secret key that signs logins. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

# Show detailed error pages. Use True only on your own computer.
DEBUG=True

# Website addresses this backend answers to (comma-separated).
ALLOWED_HOSTS=localhost,127.0.0.1

# Where the PostgreSQL database lives.
DATABASE_URL=postgres://localhost:5432/nsoro

# Frontend addresses allowed to call the API from a browser (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173
